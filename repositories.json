    },
    "rust": {
      "directory": "ReMarkableBuddies",
      "url": "https://github.com/s116821/ReMarkableBuddies.git",
      "role": "One tablet application with Reader and Writer modules",
      "issues": "https://github.com/s116821/ReMarkableBuddies/issues",
      "pullRequests": "https://github.com/s116821/ReMarkableBuddies/pulls",
      "releases": "https://github.com/s116821/ReMarkableBuddies/releases",
      "setup": "Read component AGENTS.md and docs/local-development.md; install Rust stable",
      "checks": ["cargo fmt --all -- --check", "cargo test --locked --all-features", "cargo clippy --locked --all-targets --all-features -- -D warnings"]
    },
    "manager": {
      "directory": "RemarkableBuddiesManager",
      "url": "https://github.com/s116821/RemarkableBuddiesManager.git",
      "role": "Shared Angular browser and Electron companion; host transport outside Buddy",
      "issues": "https://github.com/s116821/RemarkableBuddiesManager/issues",
      "pullRequests": "https://github.com/s116821/RemarkableBuddiesManager/pulls",
      "releases": "https://github.com/s116821/RemarkableBuddiesManager/releases",
      "setup": "Read component AGENTS.md and README.md; Node 24.21.x, npm ci, npx playwright install --with-deps chromium; Linux desktop checks require xvfb-run",
