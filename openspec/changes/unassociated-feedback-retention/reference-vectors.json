        "additionalProperties": false,
        "required": [
          "envelope_version",
          "namespace",
          "domain_schema_version",
          "record_id",
          "revision_id",
          "parents",
          "operation_id",
          "actor_id",
          "kind",
          "payload",
          "media_descriptors"
        ],
        "properties": {
          "envelope_version": {
            "const": 1
          },
          "namespace": {
            "enum": [
              "conversation",
              "source",
              "export-association",
              "subject-memory",
              "handwriting",
              "unassociated-feedback"
            ]
          },
          "domain_schema_version": {
            "enum": [
              1,
              2
            ]
          },
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid"
          },
          "parents": {
            "type": "array",
            "maxItems": 4096,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "kind": {
            "enum": [
              "value",
              "tombstone"
            ]
          },
          "payload": {},
          "media_descriptors": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sha256",
                "bytes",
                "media_type"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 268435456
                },
                "media_type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "domain_schema_version": {
                  "const": 2
                }
              }
            },
            "then": {
              "properties": {
                "namespace": {
                  "enum": [
                    "conversation",
                    "source",
                    "export-association"
                  ]
                }
              }
            }
          }
        ]
      },
      "config": {
        "$id": "urn:remarkable-buddies:config:v1",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "config_schema_version": {
            "const": 1,
            "default": 1
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "base_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "trigger_corner": {
            "enum": [
              "UR",
              "UL",
              "LR",
              "LL",
              null
            ]
          },
