              },
              "max_media_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 268435456,
                "default": 33554432
              },
              "poll_seconds": {
                "type": "integer",
                "minimum": 5,
                "maximum": 3600,
                "default": 60
              },
