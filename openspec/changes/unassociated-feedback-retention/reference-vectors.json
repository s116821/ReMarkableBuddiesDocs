                "type": "integer",
                "minimum": 1,
                "maximum": 128,
                "default": 32
              },
              "collection": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "create_new": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      },
      "manifest": {
        "$id": "urn:remarkable-buddies:manifest:contract-v2",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "transaction_id",
          "scope",
          "records",
