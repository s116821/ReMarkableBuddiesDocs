          "records": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "$ref": "#/$defs/object"
            }
          },
          "record_namespaces": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[0-9a-f]{64}$"
            },
            "additionalProperties": {
              "enum": [
                "conversation",
                "source",
                "export-association",
                "subject-memory",
                "handwriting",
                "unassociated-feedback"
              ]
            }
          },
          "media": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "$ref": "#/$defs/object"
            }
          },
          "media_coverage": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "availability",
                    "sha256"
                  ],
                  "properties": {
                    "availability": {
                      "const": "included"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "availability",
                    "sha256",
                    "reason"
                  ],
                  "properties": {
                    "availability": {
                      "const": "omitted"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "reason": {
                      "enum": [
                        "policy-disabled",
                        "size-deferred",
                        "unavailable-at-source"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
